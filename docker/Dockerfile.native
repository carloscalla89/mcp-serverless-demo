# -----------------------------------------------------------------------------
# ETAPA 1: Builder - imagen oficial de Quarkus con Mandrel 25 (downstream de
# GraalVM Community Edition) + toolchain nativo. Incluye native-image, gcc,
# glibc-devel y zlib-devel, por lo que NO hace falta instalar el toolchain C a
# mano (se evita el fallo de microdnf). El tag jdk-25 es obligatorio: Quarkus
# 3.40.x exige GraalVM/Mandrel 25 (jdk-21 trae Mandrel 23.1 y falla).
# -----------------------------------------------------------------------------
FROM quay.io/quarkus/ubi9-quarkus-mandrel-builder-image:jdk-25 AS build

WORKDIR /code

# 1. Maven Wrapper (fija la versión de Maven) + pom para cachear dependencias
COPY --chown=quarkus:quarkus --chmod=0755 mvnw /code/mvnw
COPY --chown=quarkus:quarkus .mvn /code/.mvn
COPY --chown=quarkus:quarkus pom.xml /code/

# 2. Descarga de dependencias (capa cacheable)
RUN ./mvnw -B org.apache.maven.plugins:maven-dependency-plugin:3.8.1:go-offline

# 3. Código fuente y compilación nativa con el GraalVM de la propia imagen
COPY --chown=quarkus:quarkus src /code/src
RUN ./mvnw -B package -Pnative -DskipTests \
    -Dquarkus.native.container-build=false

# -----------------------------------------------------------------------------
# ETAPA 2: Runtime (Micro Image)
# El binario nativo es Linux 64-bit y corre sobre la micro-image UBI9
# -----------------------------------------------------------------------------
FROM quay.io/quarkus/ubi9-quarkus-micro-image:2.0
WORKDIR /work/
RUN chown 1001 /work \
    && chmod "g+rwX" /work \
    && chown 1001:root /work

COPY --chown=1001:root --chmod=0755 --from=build /code/target/*-runner /work/application

EXPOSE 8080
USER 1001
CMD ["./application", "-Dquarkus.http.host=0.0.0.0"]
